# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app, for verified webhooks
PAYPAL_WEBHOOK_ID=

# Sandbox personal account that receives wages (the manager)
MUSHA_MANAGER_EMAIL=
# Sandbox personal account that approves stock money (the owner)
MUSHA_OWNER_EMAIL=

# Empty means SQLite at backend/musha.db; Render sets a Postgres URL
DATABASE_URL=
MUSHA_CURRENCY=USD
# Shared secret for the hold-keeping job
MUSHA_JOBS_KEY=
