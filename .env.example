# sandbox moves sandbox money; standin rehearses every flow in memory
MUSHA_PAYPAL=standin
PAYPAL_ENV=sandbox

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app, for verified webhooks
PAYPAL_WEBHOOK_ID=

# Sandbox personal account that approves holds (the owner)
MUSHA_OWNER_EMAIL=
# Sandbox personal account that receives released money and wages (the manager)
MUSHA_MANAGER_EMAIL=

# Musha's own sandbox sign-ins: chipo@example.com (the owner) and farai@example.com (the manager), 10 characters or more.
# The hosted service needs both. Left empty on a laptop, the first start makes random ones and logs them once
MUSHA_OWNER_SIGNIN_PASSWORD=
MUSHA_MANAGER_SIGNIN_PASSWORD=
# The WhatsApp number that plays Farai's in the sandbox shop, with its country code, such as +263771234567.
# Each start gives it to Farai. Empty keeps her thread in the dashboard alone
MUSHA_MANAGER_PHONE=

# AG Grid and AG Charts Enterprise licence for the Money view, served to the browser at runtime by /api/config.
# Empty runs the view with the trial watermark
AG_GRID_KEY=

# WhatsApp Business Cloud API (deploy/README.md, Go live on WhatsApp). With all four set, Musha's lines to a
# manager also go to the manager's WhatsApp, and the manager's WhatsApp messages come into the same thread
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# The approved template a line goes out as past the 24-hour window, while PayPal holds money for the manager
WHATSAPP_TEMPLATE=musha_update
# The Graph API version; empty uses v27.0
WHATSAPP_GRAPH_VERSION=

# Gemini: an API key, or a Google Cloud project with application default credentials (Vertex AI)
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
MUSHA_GEMINI_MODEL=gemini-3.8-flash
# The shop call's Gemini Live model. Empty picks gemini-3.8-live with an API key, gemini-live-2.5-flash on Vertex AI
MUSHA_LIVE_MODEL=

# Empty means SQLite at backend/musha.db. Cloud Run uses sqlite:////data/musha.db with Litestream; a Postgres URL works too
DATABASE_URL=
MUSHA_CURRENCY=USD
# Shared secret for the hold-keeping job endpoint
MUSHA_JOBS_KEY=
# The web process also runs the hold job every N minutes; 0 leaves it to Cloud Scheduler
MUSHA_JOBS_EVERY_MINUTES=30
# Proxies in front of the API that append to X-Forwarded-For: 1 for Cloud Run, 2 behind a Google load balancer
MUSHA_PROXY_HOPS=1
# New shops sign-up makes in an hour, for every visitor together; Cloud Run sets 30
MUSHA_SHOPS_PER_HOUR=200
